<ul class="card-text font-weight-light list-group list-group-flush">
  {% for content in data[1] %}
    <li class="list-group-item">
      <div class="d-flex flex-wrap align-items-start" style="gap: 0.5rem;">
        <div class="text-center flex-shrink-0">
          {% if content.date %} {% assign date = content.date | split: '-' | join: '.' %} {% else %} {% assign date = '' %} {% endif %}
          <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="white-space: nowrap;"> {{ date }} </span>
        </div>
        <div class="flex-grow-1">
          <h6 class="title font-weight-bold ml-1">
            <a href="{{ content.url }}">{{ content.title }}</a>
          </h6>
          <h6 class="ml-1" style="font-size: 0.95rem">{{ content.awarder }}</h6>
          <h6 class="ml-1" style="font-size: 0.95rem; font-style: italic">{{ content.summary }}</h6>
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
