---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-description">{{ page.description }}</p>
    {% if page.tags.size > 0 %}
      <p class="post-tags">
        {% if page.category %}<a href="{{ page.category | slugify | prepend: '/blog/tag/' | prepend: site.baseurl }}"><i class="fa-solid fa-tag fa-sm"></i> {{ page.category }}</a> &nbsp; &middot; &nbsp;{% endif %}
        {% for tag in page.tags %}
          {% unless tag == page.category %}
            <a href="{{ tag | slugify | prepend: '/blog/tag/' | prepend: site.baseurl }}"><i class="fa-solid fa-hashtag fa-sm"></i> {{ tag }}</a>
            &nbsp;
          {% endunless %}
        {% endfor %}
      </p>
    {% endif %}
  </header>

  <article>
    {{ content }}
  </article>

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>